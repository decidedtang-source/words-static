                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "minItems": 0,
              "maxItems": 100
            },
            "applicability": {
              "type": "string",
              "enum": [
                "APPLICABLE",
                "NOT_APPLICABLE"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
