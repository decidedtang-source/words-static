{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cardId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9:_-]+$"
    },
    "contentRevision": {
      "type": "integer",
      "minimum": 1
    },
    "targetText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "context": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "kind": {
          "type": "string",
          "enum": [
            "original_sentence",
            "generated_example"
          ]
        }
      },
      "required": [
        "text",
        "kind"
      ],
      "additionalProperties": false
    },
    "memoryGloss": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "dictionaryEntryIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[A-Za-z0-9:_-]+$"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "displayGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "title",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 4,
      "maxItems": 5
    },
    "stageEvidence": {
      "type": "object",
      "properties": {
        "dictionary": {
          "type": "object",
          "properties": {
            "refs": {
              "type": "array",
