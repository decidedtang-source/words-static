{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "batchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9:_-]+$"
    },
    "baseContentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "term": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "ipa": {
            "type": "string",
            "minLength": 0,
            "maxLength": 200
          },
          "pos": {
            "type": "string",
            "minLength": 0,
            "maxLength": 100
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "chunk": {
            "type": "string",
            "minLength": 0,
            "maxLength": 500
          },
          "example": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "level": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "gloss": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "zh": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "en",
                "zh"
              ],
              "additionalProperties": false
            },
            "minItems": 2,
            "maxItems": 10
          },
          "exampleKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "original_sentence",
                "generated_example"
              ]
            },
            "minItems": 2,
            "maxItems": 10
          },
          "editorialNote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "date",
          "term",
          "ipa",
          "pos",
          "meaning",
          "chunk",
          "example",
          "level",
          "gloss",
          "explanation",
          "examples",
          "exampleKinds"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 50
    },
    "analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cardId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "contentRevision": {
            "type": "integer",
            "minimum": 1
          },
          "targetText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "context": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "kind": {
                "type": "string",
                "enum": [
                  "original_sentence",
                  "generated_example"
                ]
              }
            },
            "required": [
              "text",
              "kind"
            ],
            "additionalProperties": false
          },
          "memoryGloss": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "dictionaryEntryIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9:_-]+$"
            },
            "minItems": 1,
            "maxItems": 100
          },
          "displayGroups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[A-Za-z0-9:_-]+$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "id",
                "title",
                "text"
              ],
              "additionalProperties": false
            },
            "minItems": 4,
            "maxItems": 5
          },
          "stageEvidence": {
            "type": "object",
            "properties": {
              "dictionary": {
                "type": "object",
                "properties": {
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "minItems": 0,
                    "maxItems": 100
                  },
                  "applicability": {
                    "type": "string",
                    "enum": [
                      "APPLICABLE",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "refs",
                  "applicability"
                ],
                "additionalProperties": false
              },
              "memory": {
                "type": "object",
                "properties": {
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "minItems": 0,
                    "maxItems": 100
                  },
                  "applicability": {
                    "type": "string",
                    "enum": [
                      "APPLICABLE",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "refs",
                  "applicability"
                ],
                "additionalProperties": false
              },
              "semanticConnection": {
                "type": "object",
                "properties": {
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "minItems": 0,
                    "maxItems": 100
                  },
                  "applicability": {
                    "type": "string",
                    "enum": [
                      "APPLICABLE",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "refs",
                  "applicability"
                ],
                "additionalProperties": false
              },
              "syntax": {
                "type": "object",
                "properties": {
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "minItems": 0,
                    "maxItems": 100
                  },
                  "applicability": {
                    "type": "string",
                    "enum": [
                      "APPLICABLE",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "refs",
                  "applicability"
                ],
                "additionalProperties": false
              },
              "concept": {
                "type": "object",
                "properties": {
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "minItems": 0,
                    "maxItems": 100
                  },
                  "applicability": {
                    "type": "string",
                    "enum": [
                      "APPLICABLE",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "refs",
                  "applicability"
                ],
                "additionalProperties": false
              },
              "contrast": {
                "type": "object",
                "properties": {
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "minItems": 0,
                    "maxItems": 100
                  },
                  "applicability": {
                    "type": "string",
                    "enum": [
                      "APPLICABLE",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "refs",
                  "applicability"
                ],
                "additionalProperties": false
              },
              "languageGame": {
                "type": "object",
                "properties": {
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "minItems": 0,
                    "maxItems": 100
                  },
                  "applicability": {
                    "type": "string",
                    "enum": [
                      "APPLICABLE",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "refs",
                  "applicability"
                ],
                "additionalProperties": false
              },
              "englishNeighbors": {
                "type": "object",
                "properties": {
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "minItems": 0,
                    "maxItems": 100
                  },
                  "applicability": {
                    "type": "string",
                    "enum": [
                      "APPLICABLE",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "refs",
                  "applicability"
                ],
                "additionalProperties": false
              },
              "pragmaticAction": {
                "type": "object",
                "properties": {
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "minItems": 0,
                    "maxItems": 100
                  },
                  "applicability": {
                    "type": "string",
                    "enum": [
                      "APPLICABLE",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "refs",
                  "applicability"
                ],
                "additionalProperties": false
              },
              "workplaceUse": {
                "type": "object",
                "properties": {
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "minItems": 0,
                    "maxItems": 100
                  },
                  "applicability": {
                    "type": "string",
                    "enum": [
                      "APPLICABLE",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "refs",
                  "applicability"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "dictionary",
              "memory",
              "semanticConnection",
              "syntax",
              "concept",
              "contrast",
              "languageGame",
              "englishNeighbors",
              "pragmaticAction",
              "workplaceUse"
            ],
            "additionalProperties": false
          },
          "coverage": {
            "type": "object",
            "properties": {
              "dictionaryStatus": {
                "type": "string",
                "enum": [
                  "REVIEWED_SELECTED_SENSES"
                ]
              },
              "analysisStatus": {
                "type": "string",
                "enum": [
                  "REVIEWED"
                ]
              },
              "copyStatus": {
                "type": "string",
                "enum": [
                  "READY"
                ]
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "morphology": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "dictionaryStatus",
              "analysisStatus",
              "copyStatus",
              "scope"
            ],
            "additionalProperties": false
          },
          "copyPayload": {
            "type": "object",
            "properties": {
              "displayText": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "context": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "original_sentence",
                      "generated_example"
                    ]
                  }
                },
                "required": [
                  "text",
                  "kind"
                ],
                "additionalProperties": false
              },
              "sourceLabel": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "shareClass": {
                "type": "string",
                "enum": [
                  "public",
                  "approved"
                ]
              }
            },
            "required": [
              "displayText",
              "context",
              "sourceLabel",
              "shareClass"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "cardId",
          "contentRevision",
          "targetText",
          "context",
          "memoryGloss",
          "dictionaryEntryIds",
          "displayGroups",
          "stageEvidence",
          "coverage",
          "copyPayload"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 50
    },
    "dictionaryEntries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "lemma": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "pos": {
            "type": "string",
            "enum": [
              "n",
              "v",
              "a",
              "s",
              "r"
            ]
          },
          "sourceEntryId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "release": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "senses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "definitionEn": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "glossZh": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "sourceExamples": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "minItems": 0,
                  "maxItems": 100
                }
              },
              "required": [
                "id",
                "definitionEn",
                "glossZh",
                "sourceExamples"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 100
          }
        },
        "required": [
          "id",
          "lemma",
          "pos",
          "sourceEntryId",
          "release",
          "source",
          "senses"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "licenses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "public/licenses/LICENSE.md",
          "public/licenses/WNDB_License.txt"
        ]
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "batchId",
    "baseContentHash",
    "cards",
    "analysis",
    "dictionaryEntries",
    "licenses"
  ],
  "additionalProperties": false
}
