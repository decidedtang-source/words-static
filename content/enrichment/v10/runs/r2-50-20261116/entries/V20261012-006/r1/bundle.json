    "blocks": [
      {
        "blockId": "syntax-concept",
        "dimensions": [
          "syntax",
          "concept"
        ],
        "text": "The main constraint作主语；is后的名词组指出限制内容，available修饰reviewers。main表示主要，不表示唯一。 问题是当前有多少评审人可用，而非对他们能力的评价。可用人数和每人的可用时段仍可能影响实际审核能力。",
        "sourceRefs": [
          {
            "sourceId": "cambridge-constraint",
            "sourceVersion": "2026-11-16",
            "locator": "countable noun, limits",
            "supportedClaim": "constraint可指限制行动的条件，不仅是物理束缚。",
            "url": "https://dictionary.cambridge.org/dictionary/english/constraint"
          }
        ],
        "title": "句子结构与当前所指"
      },
      {
        "blockId": "contrast",
        "dimensions": [
          "contrast"
        ],
        "text": "constraint是必须考虑的限制；preference是偏好；risk是未来不确定事件。已知资源不足与将来可能缺人不应混写。",
        "sourceRefs": [],
        "title": "容易混淆的地方"
      },
      {
        "blockId": "game-neighbors",
        "dimensions": [
          "languageGame",
          "englishNeighbors"
        ],
        "text": "资源策划可以据此核对排期、优先级和其他可行安排。增加评审人是否可行、是否具备资格都须另查。 resource constraint连到available reviewers和schedule；work within constraints强调在边界内安排，而非直接假定边界可消除。",
        "sourceRefs": [],
        "title": "讨论通常怎样继续"
      },
      {
        "blockId": "action",
        "dimensions": [
          "pragmaticAction"
        ],
        "text": "说话者在指出当前主要瓶颈条件，帮助团队把讨论集中在实际资源上。",
        "sourceRefs": [],
        "title": "说话者正在做什么"
      },
      {
        "blockId": "workplace",
        "dimensions": [
          "workplaceUse"
        ],
        "text": "下面是迁移到制造业沟通的新例句；不代表原场景中已发生的决定。",
        "sourceRefs": [],
        "title": "迁移到工作情境"
      }
    ],
