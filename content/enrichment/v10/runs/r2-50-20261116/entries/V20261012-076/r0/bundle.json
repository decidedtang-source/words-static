    "blocks": [
      {
        "blockId": "syntax-concept",
        "dimensions": [
          "syntax",
          "concept"
        ],
        "text": "should not否定建议做的推断；infer approval from the lack of a reply中，approval是拟推出的结论，from短语是依据。 沉默可能有多种原因，单靠未回复不足以确认批准。这里是在指出证据与结论之间的缺口，不是在判断对方真实意图。",
        "sourceRefs": [
          {
            "sourceId": "oewn-2025",
            "sourceVersion": "2025",
            "locator": "entries-i.json/infer/v / infer%2:32:00::",
            "supportedClaim": "conclude by reasoning; in logic",
            "url": "https://en-word.net/"
          }
        ],
        "title": "句子结构与当前所指"
      },
      {
        "blockId": "contrast",
        "dimensions": [
          "contrast"
        ],
        "text": "infer是听者／读者作推断，imply是信息暗示某事；confirm approval则要求明确确认。不要把三者当同一个动作。",
        "sourceRefs": [],
        "title": "容易混淆的地方"
      },
      {
        "blockId": "game-neighbors",
        "dimensions": [
          "languageGame",
          "englishNeighbors"
        ],
        "text": "在审批核对中应取得可追溯的明确回复，并核对回复针对哪个版本。原句没有规定某家公司必须采用什么批准格式。 infer X from Y把结论和依据分别摆出；evidence/explicit confirmation是下一步问题，因为目前的依据不能支持结论。",
        "sourceRefs": [],
        "title": "讨论通常怎样继续"
      },
      {
        "blockId": "action",
        "dimensions": [
          "pragmaticAction"
        ],
        "text": "说话者正在阻止一个过强推断，提醒团队不要把沉默写成批准状态。",
        "sourceRefs": [],
        "title": "说话者正在做什么"
