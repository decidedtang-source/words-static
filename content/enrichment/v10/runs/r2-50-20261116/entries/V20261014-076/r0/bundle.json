    "blocks": [
      {
        "blockId": "syntax-concept",
        "dimensions": [
          "syntax",
          "concept"
        ],
        "text": "that reflects actual use是关系从句，修饰validation method；Choose要求选择方法，不是报告确认已经完成。 现实问题是实验室达标的产品在使用者真实任务中是否合适。需要考虑典型用户、预定环境和用途；actual use限制了方法选择，不只是强调多做一次测试。",
        "sourceRefs": [
          {
            "sourceId": "nasa-verification",
            "sourceVersion": "2026-11-16",
            "locator": "5.3 Product Verification; 5.4 Product Validation",
            "supportedClaim": "Verification对照规定要求；validation关注预定使用环境和用户需求。检查、分析、演示、测试可作方法；具体选择依要求与场景，不能将NASA流程当成本公司制度。",
            "url": "https://www.nasa.gov/reference/5-0-product-realization/"
          }
        ],
        "title": "句子结构与当前所指"
      },
      {
        "blockId": "contrast",
        "dimensions": [
          "contrast"
        ],
        "text": "验证规格是否满足是verification；确认实际用途是否适合是validation。相同试验可能提供两类证据，但问题与判准必须分别清楚。",
        "sourceRefs": [],
        "title": "容易混淆的地方"
      },
      {
        "blockId": "game-neighbors",
        "dimensions": [
          "languageGame",
          "englishNeighbors"
        ],
        "text": "这是确认策划：先明确用户任务和使用条件，再选择怎样观察是否达到预期用途。NASA框架提供概念区分，不替用户公司规定审批流程。 intended use连到使用目标；representative conditions连到试验环境；user needs连到判定是否真正适用。",
        "sourceRefs": [],
        "title": "讨论通常怎样继续"
      },
      {
        "blockId": "action",
        "dimensions": [
          "pragmaticAction"
        ],
        "text": "说话者要求方法与使用情境相匹配，反对只凭方便就选择一种不相关的检查。",
        "sourceRefs": [],
        "title": "说话者正在做什么"
      },
      {
        "blockId": "workplace",
        "dimensions": [
          "workplaceUse"
        ],
        "text": "下面是迁移到制造业沟通的新例句；不代表原场景中已发生的决定。",
        "sourceRefs": [],
        "title": "迁移到工作情境"
      }
    ],
    "workplaceUse": [
      {
        "en": "Does this validation method represent the intended operating conditions?",
        "zh": "这种确认方法能代表预定运行条件吗？",
        "whenToUse": "审查方法与用途是否匹配。",
