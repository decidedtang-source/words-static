    "blocks": [
      {
        "blockId": "syntax-concept",
        "dimensions": [
          "syntax",
          "concept"
        ],
        "text": "will同时作用于monitor和report；any significant change是要报告的对象，significant不能省略成所有细微波动。 监测提供发现变化的机会，但原句没有规定频率、指标或“显著”的阈值。监测也不等于已纠正问题。",
        "sourceRefs": [
          {
            "sourceId": "oewn-2025",
            "sourceVersion": "2025",
            "locator": "entries-m.json/monitor/v / monitor%2:39:00::",
            "supportedClaim": "keep tabs on; keep an eye on; keep under surveillance",
            "url": "https://en-word.net/"
          }
        ],
        "title": "句子结构与当前所指"
      },
      {
        "blockId": "contrast",
        "dimensions": [
          "contrast"
        ],
        "text": "monitor是持续关注；inspect常指具体检查；control包含采取措施影响状态。监测可以支持控制，却不是自动控制。",
        "sourceRefs": [],
        "title": "容易混淆的地方"
      },
      {
        "blockId": "game-neighbors",
        "dimensions": [
          "languageGame",
          "englishNeighbors"
        ],
        "text": "执行前可约定看哪些指标、多久更新、怎样判定显著以及向谁报告，让持续观察有明确用途。 monitor progress与status update连接；significant change引出阈值或影响判断；report是监测之后的信息动作。",
        "sourceRefs": [],
        "title": "讨论通常怎样继续"
      },
      {
        "blockId": "action",
        "dimensions": [
          "pragmaticAction"
        ],
        "text": "说话者在承诺持续观察并通报重大变化。",
        "sourceRefs": [],
        "title": "说话者正在做什么"
      },
      {
        "blockId": "workplace",
        "dimensions": [
