            "sourceId": "cambridge-qualify",
            "sourceVersion": "2026-11-16",
            "locator": "verb, limit a statement",
            "supportedClaim": "qualify可给陈述加限定；与具备资格义区分。",
            "url": "https://dictionary.cambridge.org/dictionary/english/qualify"
          }
        ]
      }
    },
    {
